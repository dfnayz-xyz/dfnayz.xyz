#!/bin/bash
# Downloads every image and video from dfnayz.xyz (Cargo) into this folder:
#   img/        web-sized copies the site uses (images ~2000px, videos as-is)
#   originals/  full-resolution originals, your archive
# Then switches the site to use img/ instead of Cargo. Double-click to run
# (first time: right-click → Open).
cd "$(dirname "$0")"
mkdir -p img originals
B="https://freight.cargo.site"
n=0; fail=0
while read -r kind hash name; do
  [ -z "$hash" ] && continue
  if [ "$kind" = "i" ]; then
    web="$B/w/2000/q/85/i/$hash/$name"; orig="$B/t/original/i/$hash/$name"
  else
    web="$B/m/$hash/$name"; orig="$web"
  fi
  out="img/$hash-$name"
  if [ ! -s "$out" ]; then curl -fsSL "$web" -o "$out" || { echo "failed: $name"; fail=$((fail+1)); rm -f "$out"; }; fi
  if [ "$kind" = "i" ] && [ ! -s "originals/$name" ]; then curl -fsSL "$orig" -o "originals/$name" || true; fi
  if [ "$kind" = "m" ] && [ -s "$out" ] && [ ! -s "originals/$name" ]; then cp "$out" "originals/$name"; fi
  n=$((n+1)); echo "$n  $name"
done <<'LIST'
