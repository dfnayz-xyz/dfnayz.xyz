if [ "$fail" = "0" ]; then
  sed -i '' 's/const USE_LOCAL = false;/const USE_LOCAL = true;/' works.js 2>/dev/null || sed -i 's/const USE_LOCAL = false;/const USE_LOCAL = true;/' works.js
  echo "Done: $n files. The site now uses the img folder."
else
  echo "Done with $fail failures. Run again to retry; the site still loads from Cargo."
fi
